{
  "name": "svelte-bundle-quantarium",
  "version": "0.0.24",
  "description": "This is a modified version of svelte-bundle specifically for Quantarium. It bundles Svelte files into static HTML files",
  "type": "module",
  "bin": {
    "svelte-bundle": "cli.js"
  },
  "files": [
    "cli.js",
    "bundle.js"
  ],
  "keywords": [
    "svelte",
    "bundle",
    "static",
    "html",
    "ssr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MariusIorgaQuantarium/svelte-bundle.git"
  },
  "scripts": {
    "prepublishOnly": "chmod +x cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Teddy Hartling",
  "license": "MIT",
  "dependencies": {
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.0.2",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "autoprefixer": "^10.4.20",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "cssnano": "^7.0.6",
    "rollup": "^3.20.0",
    "rollup-plugin-css-only": "^4.3.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svelte": "^7.1.4",
    "svelte": "^3.58.0",
    "svelte-preprocess": "^5.1.4",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=18"
  }
}
